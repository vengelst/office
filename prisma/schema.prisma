// Office – Prisma Schema
// CRM, Projektverwaltung, Monteurverwaltung, Zeiterfassung, Stundenzettel, DMS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────

enum RoleCode {
  SUPERADMIN
  OFFICE
  PROJECT_MANAGER
  WORKER
  CUSTOMER_PL // Kunden-Projektleiter – getrennt von internen Rollen
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  DRAFT
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

enum ServiceType {
  VIDEO
  ELECTRICAL
  SERVICE
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BreakScopeType {
  GLOBAL
  PROJECT
}

enum TimeEntryType {
  CLOCK_IN
  CLOCK_OUT
  MANUAL_ADJUSTMENT
  BREAK_START
  BREAK_END
}

enum GpsEventType {
  CLOCK_IN
  CLOCK_OUT
  MANUAL
}

enum WeeklyTimesheetStatus {
  DRAFT
  WORKER_SIGNED
  CUSTOMER_SIGNED
  COMPLETED
  LOCKED
  // Freigabe-Workflow (Monteur reicht ein → Vorarbeiter/PM prüft)
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
  ARCHIVED
}

enum SignerType {
  WORKER
  CUSTOMER
  SUPERVISOR
  MANAGER
}

enum DocumentType {
  PHOTO
  DELIVERY_NOTE
  INVOICE
  PROJECT_DOC
  BUSINESS_CARD
  CONTRACT
  LOGO
  CERTIFICATE
  NOTE_DOCUMENT
  DRAWING
  WORK_CONTRACT
  SPECIFICATION
  SITE_PHOTO
  HANDOVER_PROTOCOL
  PASSPORT
  ID_CARD
  WORK_PERMIT
  RESIDENCE_PERMIT
  CERTIFICATION
  HEALTH_CERTIFICATE
  WORKER_PHOTO
  REGISTRATION_DOC // Fahrzeugschein
  INSURANCE_DOC // Versicherungsnachweis
  INSPECTION_DOC // TÜV/HU-Bericht
  OTHER
}

enum WorkerType {
  EMPLOYED // fest angestellt
  SUBCONTRACTED // über Subunternehmen
}

enum WorkerAvailability {
  AVAILABLE // verfügbar
  ON_PROJECT // im Projekteinsatz
  SICK // krank
  VACATION // Urlaub
  UNAVAILABLE // nicht verfügbar
}

enum LanguageProficiency {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE // Muttersprache
}

enum EquipmentCategory {
  TOOL
  PSA
  ELECTRONICS
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
}

enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  POOR
  DEFECTIVE
}

enum InvoiceType {
  OUTGOING // Ausgangsrechnung (an Kunde)
  INCOMING // Eingangsrechnung (von Sub)
}

enum InvoiceStatus {
  DRAFT // Entwurf
  SENT // Versendet
  PARTIALLY_PAID // Teilweise bezahlt
  PAID // Vollständig bezahlt
  CANCELLED // Storniert
}

enum InvoiceLineType {
  WEEKLY_PACKAGE // Wochenpaket-Pauschale
  OVERTIME // Überstunden
  UNIT_BASED // Einheitsbasiert (Meter, Stück, etc.)
  PARTIAL_PAYMENT // Abschlagsrechnung
  CUSTOM // Freie Position
}

enum SubmissionStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  WON
  LOST
  CANCELLED
}

// ── Arbeitsitems (item-/positionsbasierte Arbeitszuteilung) ────

enum WorkItemStatus {
  OPEN // Offen – im Pool, keine Zuordnung
  IN_PROGRESS // In Arbeit – bei einem/mehreren Monteuren
  REVIEW // Kontrolle – wartet auf Kunden-PL
  REWORK // Nacharbeit – nicht fertig, bleibt beim Monteur
  APPROVED // Geprüft – abrechenbar
}

enum WorkItemReportType {
  COMPLETED // Fertigmeldung (Pflicht: min. 2 Fotos)
  REWORK // Nacharbeit
}

enum WorkItemReviewAction {
  APPROVE // Geprüft / OK
  FORCE_COMPLETE // Kunden-PL setzt selbst fertig
}

enum SubmissionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ──────────────────────────────────────────────────────────────
// Identity / System
// ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles                UserRole[]
  auditLogs            AuditLog[]
  sessions             Session[]
  customerNotes        CustomerNote[]
  customerCallLogs     CustomerCallLog[]
  projectNotes         ProjectNote[]
  timeEntries          TimeEntry[]
  worker               Worker?
  documents            Document[]
  managedProjects      Project[]              @relation("ProjectManager")
  projectStatusChanges ProjectStatusHistory[]
  reviewedTimesheets   WeeklyTimesheet[]      @relation("TimesheetReviewer")
  approvedTimesheets   WeeklyTimesheet[]      @relation("TimesheetApprover")
  createdInvoices      Invoice[]              @relation("InvoiceCreator")

  customerPlProjects ProjectCustomerPlAssignment[]
  workItemReviews    WorkItemReview[]
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?

  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorType   String
  entityType  String
  entityId    String
  action      String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson Json
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────
// CRM
// ──────────────────────────────────────────────────────────────

model Customer {
  id              String         @id @default(cuid())
  customerNumber  String         @unique
  companyName     String
  legalForm       String?
  status          CustomerStatus @default(ACTIVE)
  phone           String?
  website         String?
  vatId           String?
  taxNumber       String?
  industry        String?
  rating          String?
  paymentTermDays Int?
  addressLine1    String?
  addressLine2    String?
  postalCode      String?
  city            String?
  country         String?
  latitude        Float?
  longitude       Float?
  mapsUrl         String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  branches          CustomerBranch[]
  contacts          CustomerContact[]
  emails            CustomerEmail[]
  bankAccounts      CustomerBankAccount[]
  customerNotes     CustomerNote[]
  callLogs          CustomerCallLog[]
  projects          Project[]
  invoices          Invoice[]
  submissions       Submission[]
  workCardTemplates WorkCardTemplate[]

  @@index([status, deletedAt])
  @@index([companyName])
  @@index([deletedAt])
}

model CustomerEmail {
  id         String  @id @default(cuid())
  customerId String
  email      String
  emailType  String // GENERAL, BILLING, SERVICE, SUPPORT, PROJECT, OTHER
  label      String? // Freitext-Bezeichnung
  isPrimary  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerBankAccount {
  id            String  @id @default(cuid())
  customerId    String
  bankName      String
  iban          String
  bic           String?
  accountHolder String?
  isPrimary     Boolean @default(false)
  notes         String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerBranch {
  id           String  @id @default(cuid())
  customerId   String
  name         String
  branchType   String? // HEADQUARTERS, OFFICE, WAREHOUSE, SITE, OTHER
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String?
  latitude     Float?
  longitude    Float?
  mapsUrl      String?
  phone        String?
  email        String?
  notes        String?
  active       Boolean @default(true)

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contacts CustomerContact[]
  projects Project[]
}

model CustomerContact {
  id                     String    @id @default(cuid())
  customerId             String
  branchId               String?
  title                  String? // Anrede (Herr, Frau, Dr., etc.)
  firstName              String
  lastName               String
  role                   String?
  department             String?
  email                  String?
  phoneMobile            String?
  phoneLandline          String?
  addressLine1           String?
  addressLine2           String?
  postalCode             String?
  city                   String?
  country                String?
  birthday               DateTime?
  linkedInUrl            String?
  preferredContactMethod String? // EMAIL, PHONE, MOBILE
  isAccountingContact    Boolean   @default(false)
  isProjectContact       Boolean   @default(false)
  isSignatory            Boolean   @default(false)
  notes                  String?
  googleContactId        String?
  syncToGoogle           Boolean   @default(true)

  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch             CustomerBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  callLogs           CustomerCallLog[]
  primaryForProjects Project[]         @relation("PrimaryContact")
}

model CustomerNote {
  id              String   @id @default(cuid())
  customerId      String
  body            String
  createdByUserId String
  createdAt       DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdByUserId], references: [id])
}

model CustomerCallLog {
  id              String   @id @default(cuid())
  customerId      String
  contactId       String?
  projectId       String?
  subject         String
  callDate        DateTime
  direction       String
  summary         String
  nextAction      String?
  createdByUserId String
  createdAt       DateTime @default(now())

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact   CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User             @relation(fields: [createdByUserId], references: [id])
}

// ──────────────────────────────────────────────────────────────
// Projects
// ──────────────────────────────────────────────────────────────

model Project {
  id                           String        @id @default(cuid())
  projectNumber                String        @unique
  customerId                   String
  branchId                     String?
  title                        String
  description                  String?
  serviceType                  ServiceType
  status                       ProjectStatus @default(DRAFT)
  priority                     Priority      @default(MEDIUM)
  siteName                     String?
  siteAddressLine1             String?
  sitePostalCode               String?
  siteCity                     String?
  siteCountry                  String?
  latitude                     Float?
  longitude                    Float?
  mapsUrl                      String?
  siteAccessInfo               String?
  siteWorkingHours             String?
  billingMode                  String? // HOURLY_PACKAGE | UNIT_BASED | MIXED
  weeklyPackageHours           Float?
  weeklyPackagePrice           Float?
  overtimeRatePerHour          Float?
  accommodationAddressLine1    String?
  accommodationAddressLine2    String?
  accommodationPostalCode      String?
  accommodationCity            String?
  accommodationCountry         String?
  accommodationLatitude        Float?
  accommodationLongitude       Float?
  accommodationMapsUrl         String?
  accommodationNotes           String?
  plannedStartDate             DateTime?
  plannedEndDate               DateTime?
  actualStartDate              DateTime?
  actualEndDate                DateTime?
  internalProjectManagerUserId String?
  primaryCustomerContactId     String?
  pauseRuleId                  String?
  itemBased                    Boolean       @default(false) // Projekt wird über Work Items abgearbeitet
  notes                        String?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt
  deletedAt                    DateTime?

  customer               Customer         @relation(fields: [customerId], references: [id])
  branch                 CustomerBranch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  internalProjectManager User?            @relation("ProjectManager", fields: [internalProjectManagerUserId], references: [id], onDelete: SetNull)
  primaryCustomerContact CustomerContact? @relation("PrimaryContact", fields: [primaryCustomerContactId], references: [id], onDelete: SetNull)
  pauseRule              BreakRule?       @relation("ProjectPauseRule", fields: [pauseRuleId], references: [id], onDelete: SetNull)

  notesList        ProjectNote[]
  assignments      ProjectAssignment[]
  emailRecipients  ProjectEmailRecipient[]
  sites            ProjectSite[]
  equipment        ProjectEquipment[]
  statusHistory    ProjectStatusHistory[]
  breakRules       BreakRule[]                   @relation("ProjectBreakRules")
  timeEntries      TimeEntry[]
  gpsEvents        GpsEvent[]
  weeklyTimesheets WeeklyTimesheet[]
  callLogs         CustomerCallLog[]
  invoices         Invoice[]
  blocks           ProjectBlock[]
  workItems        WorkItem[]
  customerPls      ProjectCustomerPlAssignment[]

  @@index([customerId])
  @@index([status, deletedAt])
  @@index([deletedAt])
}

model ProjectSite {
  id           String   @id @default(cuid())
  projectId    String
  name         String // z.B. "Gebäude A", "Tiefgarage", "Außenbereich"
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String?
  latitude     Float?
  longitude    Float?
  mapsUrl      String?
  accessInfo   String? // Zugangsinfos für diesen Standort
  notes        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectEquipment {
  id              String    @id @default(cuid())
  projectId       String
  name            String // z.B. "Bohrmaschine Hilti TE 70", "Leiter 8m"
  description     String?
  quantity        Int       @default(1)
  serialNumber    String? // Falls vorhanden
  issuedAt        DateTime  @default(now()) // Ausgegeben am
  returnedAt      DateTime? // Zurückgegeben am (null = noch draußen)
  issuedTo        String? // An wen ausgegeben (Freitext oder Worker-Referenz)
  condition       String? // Zustand bei Ausgabe
  returnCondition String? // Zustand bei Rückgabe
  notes           String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectStatusHistory {
  id              String   @id @default(cuid())
  projectId       String
  fromStatus      String?
  toStatus        String
  changedByUserId String?
  comment         String?
  changedAt       DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
}

model ProjectNote {
  id              String   @id @default(cuid())
  projectId       String
  body            String
  createdByUserId String
  createdAt       DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdByUserId], references: [id])
}

model ProjectAssignment {
  id        String    @id @default(cuid())
  projectId String
  workerId  String
  roleName  String?
  startDate DateTime
  endDate   DateTime?
  active    Boolean   @default(true)
  isLead    Boolean   @default(false)
  notes     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model ProjectEmailRecipient {
  id            String  @id @default(cuid())
  projectId     String
  email         String
  recipientType String
  name          String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────────────────────
// Workers
// ──────────────────────────────────────────────────────────────

model Worker {
  id                String    @id @default(cuid())
  workerNumber      String    @unique
  firstName         String
  lastName          String
  email             String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  postalCode        String?
  city              String?
  country           String?
  nationality       String?
  active            Boolean   @default(true)
  photoPath         String?
  hasDriversLicense Boolean   @default(false)
  notes             String?
  userId            String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // --- Deprecated: durch strukturierte Modelle/Felder ersetzt, bleiben für Altdaten ---
  languageCode     String? // @deprecated → WorkerLanguage
  emergencyContact String? // @deprecated → emergencyContact* Felder
  qualifications   String? // @deprecated → WorkerCertification

  // --- Stammdaten ---
  workerType   WorkerType         @default(SUBCONTRACTED)
  availability WorkerAvailability @default(AVAILABLE)
  dateOfBirth  DateTime?
  placeOfBirth String?

  // --- Kontakt & Notfall ---
  phoneSecondary           String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // --- Ausweise & Reisedokumente ---
  idNumber              String? // Personalausweis-Nr.
  taxNumber             String? // Steuernummer
  socialSecurityNumber  String? // Sozialversicherungsnummer
  oib                   String? // OIB (Kroatien/Balkan)
  passportNumber        String?
  passportExpiry        DateTime?
  residencePermitNumber String?
  residencePermitExpiry DateTime?
  workPermitNumber      String?
  workPermitExpiry      DateTime?

  // --- Vertrag & Kosten ---
  subcontractorId String?
  contractStart   DateTime?
  contractEnd     DateTime?
  hourlyRate      Float?
  dailyRate       Float?

  // --- PSA-Größen ---
  shoeSize     String?
  clothingSize String? // S, M, L, XL, XXL, etc.

  user                 User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subcontractor        Subcontractor?            @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  pins                 WorkerPin[]
  assignments          ProjectAssignment[]
  vehicleAssignments   WorkerVehicleAssignment[]
  equipmentIssues      WorkerEquipmentIssue[]
  timeEntries          TimeEntry[]
  gpsEvents            GpsEvent[]
  weeklyTimesheets     WeeklyTimesheet[]
  languages            WorkerLanguage[]
  certifications       WorkerCertification[]
  teamMemberships      WorkerTeamMember[]
  equipmentAssignments EquipmentAssignment[]
  workItemAssignments  WorkItemAssignment[]
  workItemSessions     WorkItemSession[]
  workItemReports      WorkItemReport[]

  @@index([deletedAt])
  @@index([subcontractorId])
  @@index([active, deletedAt])
}

enum SubcontractorType {
  SUBCONTRACTOR
  SUPPLIER
}

model Subcontractor {
  id                String            @id @default(cuid())
  name              String
  subcontractorType SubcontractorType @default(SUBCONTRACTOR)
  contactPerson     String?
  email             String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  postalCode        String?
  city              String?
  country           String?
  latitude          Float?
  longitude         Float?
  mapsUrl           String?
  taxNumber         String?
  vatId             String?
  iban              String?
  bic               String?
  bankName          String?
  notes             String?
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  workers  Worker[]
  invoices Invoice[]
  vehicles Vehicle[]
}

model WorkerLanguage {
  id          String              @id @default(cuid())
  workerId    String
  language    String // "Deutsch", "Englisch", "Kroatisch", etc.
  proficiency LanguageProficiency

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, language])
}

model WorkerCertification {
  id         String    @id @default(cuid())
  workerId   String
  name       String // z.B. "Elektrofachkraft", "SCC", "Ersthelfer", "Höhenarbeiter"
  issuedBy   String? // Ausstellende Stelle
  issuedDate DateTime?
  expiryDate DateTime?
  notes      String?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model WorkerTeam {
  id          String   @id @default(cuid())
  name        String
  description String?
  leaderId    String? // Worker-ID des Teamleiters
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members WorkerTeamMember[]
}

model WorkerTeamMember {
  id       String    @id @default(cuid())
  teamId   String
  workerId String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  role     String? // z.B. "Elektriker", "Helfer"

  team   WorkerTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  worker Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([teamId, workerId, leftAt])
}

model WorkerPin {
  id        String    @id @default(cuid())
  workerId  String
  pinHash   String
  validFrom DateTime
  validTo   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────────────────────
// Vehicles / Equipment
// ──────────────────────────────────────────────────────────────

model Vehicle {
  id           String  @id @default(cuid())
  licensePlate String  @unique
  make         String?
  model        String?
  internalName String?
  active       Boolean @default(true)
  notes        String?

  // --- Eigentümer (eigenes Fahrzeug vs. Sub-Fahrzeug) ---
  ownerType       String? // "OWN" oder "SUBCONTRACTOR"
  subcontractorId String? // Falls Sub-Fahrzeug: welcher Sub

  // --- Stammdaten ---
  category String? // "PKW", "Transporter", "LKW", "Anhänger"
  year     Int? // Baujahr
  vin      String? // Fahrgestellnummer (FIN)
  color    String?
  fuelType String? // "Diesel", "Benzin", "Elektro", "Hybrid"

  // --- Dokumente & Fristen ---
  nextInspection  DateTime? // Nächster TÜV/HU
  insuranceExpiry DateTime? // Versicherung Ablauf
  registrationDoc String? // Pfad zum Fahrzeugschein in MinIO

  subcontractor Subcontractor?            @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  assignments   WorkerVehicleAssignment[]
}

model WorkerVehicleAssignment {
  id           String    @id @default(cuid())
  workerId     String
  vehicleId    String
  assignedFrom DateTime
  assignedTo   DateTime?
  notes        String?

  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model EquipmentItem {
  id           String            @id @default(cuid())
  itemNumber   String            @unique
  category     EquipmentCategory
  name         String
  serialNumber String?
  trackable    Boolean           @default(false)
  active       Boolean           @default(true)
  notes        String?

  issues WorkerEquipmentIssue[]
}

model WorkerEquipmentIssue {
  id              String    @id @default(cuid())
  workerId        String
  equipmentItemId String
  issuedAt        DateTime
  returnedAt      DateTime?
  conditionOut    String?
  conditionIn     String?
  notes           String?

  worker        Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)
}

model Equipment {
  id              String  @id @default(cuid())
  name            String
  description     String? @db.Text
  category        String?
  manufacturer    String?
  model           String?
  serialNumber    String?
  inventoryNumber String? @unique

  purchaseDate  DateTime?
  purchasePrice Decimal?  @db.Decimal(10, 2)

  status    EquipmentStatus    @default(AVAILABLE)
  condition EquipmentCondition @default(GOOD)

  imageKey String?
  notes    String? @db.Text

  assignments EquipmentAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, deletedAt])
  @@index([category, deletedAt])
}

model EquipmentAssignment {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  workerId    String
  worker      Worker    @relation(fields: [workerId], references: [id])

  assignedAt     DateTime  @default(now())
  expectedReturn DateTime?
  returnedAt     DateTime?

  notes           String?             @db.Text
  returnNotes     String?             @db.Text
  returnCondition EquipmentCondition?

  assignedBy String?

  @@index([equipmentId, returnedAt])
  @@index([workerId, returnedAt])
}

// ──────────────────────────────────────────────────────────────
// Time Tracking
// ──────────────────────────────────────────────────────────────

model BreakRule {
  id                String         @id @default(cuid())
  scopeType         BreakScopeType
  projectId         String?
  name              String
  autoDeductEnabled Boolean        @default(true)
  thresholdMinutes1 Int
  breakMinutes1     Int
  thresholdMinutes2 Int?
  breakMinutes2     Int?
  active            Boolean        @default(true)

  project        Project?  @relation("ProjectBreakRules", fields: [projectId], references: [id], onDelete: Cascade)
  pausedProjects Project[] @relation("ProjectPauseRule")
}

model TimeEntry {
  id               String        @id @default(cuid())
  workerId         String
  projectId        String
  entryType        TimeEntryType
  occurredAtClient DateTime
  occurredAtServer DateTime      @default(now())
  latitude         Float?
  longitude        Float?
  accuracy         Float?
  comment          String?
  sourceDevice     String?
  createdByUserId  String?
  createdAt        DateTime      @default(now())

  worker    Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  gpsEvents GpsEvent[]

  @@index([workerId, projectId])
  @@index([occurredAtClient])
}

model GpsEvent {
  id                 String       @id @default(cuid())
  workerId           String
  projectId          String?
  relatedTimeEntryId String?
  latitude           Float
  longitude          Float
  accuracy           Float?
  recordedAt         DateTime
  eventType          GpsEventType

  worker           Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project          Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  relatedTimeEntry TimeEntry? @relation(fields: [relatedTimeEntryId], references: [id], onDelete: SetNull)
}

// ──────────────────────────────────────────────────────────────
// Timesheets
// ──────────────────────────────────────────────────────────────

model WeeklyTimesheet {
  id                String                @id @default(cuid())
  workerId          String
  projectId         String
  weekYear          Int
  weekNumber        Int
  status            WeeklyTimesheetStatus @default(DRAFT)
  totalMinutesGross Int?
  totalBreakMinutes Int?
  totalMinutesNet   Int?
  generatedAt       DateTime              @default(now())
  lockedAt          DateTime?

  // Freigabe-Workflow
  submittedAt      DateTime? // Wann eingereicht
  reviewedAt       DateTime? // Wann geprüft
  approvedAt       DateTime? // Wann freigegeben
  rejectedAt       DateTime? // Wann zurückgewiesen
  rejectionReason  String? // Grund für Zurückweisung
  reviewedByUserId String? // Wer hat geprüft
  approvedByUserId String? // Wer hat freigegeben

  worker       Worker                     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy   User?                      @relation("TimesheetReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedBy   User?                      @relation("TimesheetApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  days         WeeklyTimesheetDay[]
  signatures   WeeklyTimesheetSignature[]
  invoiceLines InvoiceLine[]

  @@unique([workerId, projectId, weekYear, weekNumber])
}

model WeeklyTimesheetDay {
  id                String    @id @default(cuid())
  weeklyTimesheetId String
  workDate          DateTime
  firstClockInAt    DateTime?
  lastClockOutAt    DateTime?
  grossMinutes      Int?
  breakMinutes      Int?
  netMinutes        Int?
  summaryComment    String?
  clockInLatitude   Float?
  clockInLongitude  Float?
  clockOutLatitude  Float?
  clockOutLongitude Float?

  weeklyTimesheet WeeklyTimesheet @relation(fields: [weeklyTimesheetId], references: [id], onDelete: Cascade)
}

model WeeklyTimesheetSignature {
  id                 String     @id @default(cuid())
  weeklyTimesheetId  String
  signerType         SignerType
  signerName         String
  signerRole         String?
  signatureImagePath String
  signedAt           DateTime   @default(now())
  ipAddress          String?
  deviceInfo         String?

  weeklyTimesheet WeeklyTimesheet @relation(fields: [weeklyTimesheetId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────────────────────
// Documents
// ──────────────────────────────────────────────────────────────

model Document {
  id               String       @id @default(cuid())
  storageKey       String
  originalFilename String
  mimeType         String
  fileSize         Int
  uploadedByUserId String?
  documentType     DocumentType
  title            String?
  description      String?
  createdAt        DateTime     @default(now())

  // Neue Felder
  storagePath   String? // Logischer Pfad: z.B. "customers/cuid123/contracts/vertrag.pdf"
  thumbnailKey  String? // MinIO-Key für Thumbnail (bei Bildern)
  version       Int       @default(1)
  replacesId    String? // ID des Vorgänger-Dokuments (bei Versionen)
  isLatest      Boolean   @default(true) // Nur die aktuelle Version ist "latest"
  expiryDate    DateTime? // Ablaufdatum (für Pässe, Zertifikate, etc.)
  tags          String? // Komma-separierte Tags für Suche
  uploadSource  String? // "web", "camera", "mobile"
  driveFileId   String? // Google Drive File-ID
  driveFolderId String? // Google Drive Ordner-ID

  uploadedBy User?          @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  links      DocumentLink[]

  replacedBy       Document?  @relation("DocumentVersions", fields: [replacesId], references: [id])
  previousVersions Document[] @relation("DocumentVersions")

  @@index([isLatest])
  @@index([documentType])
  @@index([createdAt])
}

model DocumentLink {
  id         String  @id @default(cuid())
  documentId String
  entityType String
  entityId   String
  folderId   String? // Optional: In welchem Ordner liegt das Dokument

  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder   DocumentFolder? @relation(fields: [folderId], references: [id])

  @@index([entityType, entityId])
  @@index([documentId])
}

model DocumentFolder {
  id         String  @id @default(cuid())
  entityType String // "CUSTOMER", "PROJECT", "WORKER", "VEHICLE"
  entityId   String
  name       String // z.B. "Verträge", "Ausweise", "Fotos"
  parentId   String? // Für Unterordner
  sortOrder  Int     @default(0)

  parent   DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children DocumentFolder[] @relation("FolderTree")
  links    DocumentLink[]

  @@unique([entityType, entityId, name, parentId])
}

// ──────────────────────────────────────────────────────────────
// Communication
// ──────────────────────────────────────────────────────────────

model CommunicationEntry {
  id         String                  @id @default(cuid())
  entityType CommunicationEntityType
  entityId   String
  contactId  String?
  type       CommunicationType
  direction  CommunicationDirection  @default(OUTGOING)
  subject    String?
  content    String                  @db.Text
  occurredAt DateTime                @default(now())
  duration   Int?
  createdBy  String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([entityType, entityId, occurredAt])
  @@index([contactId, occurredAt])
}

enum CommunicationEntityType {
  CUSTOMER
  SUBCONTRACTOR
  WORKER
}

enum CommunicationType {
  PHONE_CALL
  EMAIL
  MEETING
  NOTE
  INSTRUCTION
}

enum CommunicationDirection {
  INCOMING
  OUTGOING
}

// ──────────────────────────────────────────────────────────────
// Todos / Aufgaben
// ──────────────────────────────────────────────────────────────

model Todo {
  id String @id @default(cuid())

  title       String
  description String? @db.Text

  status   TodoStatus   @default(OPEN)
  priority TodoPriority @default(MEDIUM)

  dueDate     DateTime?
  completedAt DateTime?

  assignedToId String?
  createdById  String?

  linkedEntityType TodoEntityType?
  linkedEntityId   String?
  linkedEntityName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, assignedToId, dueDate])
  @@index([linkedEntityType, linkedEntityId])
  @@index([createdById])
}

enum TodoStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TodoEntityType {
  CUSTOMER
  PROJECT
  WORKER
  SUBCONTRACTOR
  EQUIPMENT
}

model EmailLog {
  id                String    @id @default(cuid())
  recipientEmail    String
  subject           String
  body              String?
  attachmentPath    String?
  sentAt            DateTime?
  status            String
  errorMessage      String?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime  @default(now())
}

// ──────────────────────────────────────────────────────────────
// Invoices / Abrechnung
// ──────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // RE-YYYY-NNNN (Ausgang) / ER-YYYY-NNNN (Eingang)
  invoiceType   InvoiceType
  status        InvoiceStatus @default(DRAFT)

  // Bezug
  projectId       String?
  customerId      String? // Bei OUTGOING: Rechnungsempfänger
  subcontractorId String? // Bei INCOMING: Rechnungssteller

  // Zeitraum
  periodFrom DateTime?
  periodTo   DateTime?

  // Beträge
  subtotal  Float @default(0) // Netto-Summe
  taxRate   Float @default(19) // MwSt-Satz in %
  taxAmount Float @default(0) // MwSt-Betrag
  total     Float @default(0) // Brutto-Summe

  // Teilrechnung
  isPartialInvoice  Boolean @default(false)
  partialNumber     Int? // 1. Abschlag, 2. Abschlag, etc.
  partialPercentage Float? // % des Gesamtauftrags

  // Zahlungsziel
  paymentTermDays Int? // Überschreibt Kunden-Default
  issueDate       DateTime  @default(now())
  dueDate         DateTime? // issueDate + paymentTermDays
  paidDate        DateTime?
  paidAmount      Float? // Bei Teilzahlung

  // Metadaten
  notes           String?
  internalNotes   String?
  pdfPath         String? // Pfad zur generierten PDF in MinIO
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  // Relations
  project       Project?         @relation(fields: [projectId], references: [id])
  customer      Customer?        @relation(fields: [customerId], references: [id])
  subcontractor Subcontractor?   @relation(fields: [subcontractorId], references: [id])
  createdBy     User?            @relation("InvoiceCreator", fields: [createdByUserId], references: [id])
  lines         InvoiceLine[]
  payments      InvoicePayment[]

  @@index([status])
  @@index([customerId])
  @@index([projectId])
  @@index([subcontractorId])
  @@index([invoiceType, status])
}

model InvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  lineType    InvoiceLineType
  position    Int // Reihenfolge
  description String
  quantity    Float           @default(1)
  unit        String? // "Std", "Stk", "m", "m²", "Pauschale", "KW"
  unitPrice   Float           @default(0)
  total       Float           @default(0) // quantity * unitPrice

  // Referenz auf Stundenzettel (optional)
  weeklyTimesheetId String?

  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  weeklyTimesheet WeeklyTimesheet? @relation(fields: [weeklyTimesheetId], references: [id])
}

model InvoicePayment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  paidDate  DateTime
  method    String? // "Überweisung", "Bar", etc.
  reference String? // Buchungsreferenz
  notes     String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────────────────────
// Submissions / Ausschreibungen
// ──────────────────────────────────────────────────────────────

model Submission {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  reference   String?
  source      String?

  status   SubmissionStatus   @default(OPEN)
  priority SubmissionPriority @default(MEDIUM)

  deadline  DateTime?
  startDate DateTime?
  endDate   DateTime?

  value Decimal? @db.Decimal(12, 2)

  contactName  String?
  contactEmail String?
  contactPhone String?

  requirements String? @db.Text
  notes        String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId, status, deletedAt])
}

// ──────────────────────────────────────────────────────────────
// Arbeitsitems (item-/positionsbasierte Arbeitszuteilung)
// Siehe SPEZ-arbeitsitems.md
// ──────────────────────────────────────────────────────────────

/// Gruppierung von Work Items, typisch 1 PDF pro Block.
model ProjectBlock {
  id            String   @id @default(cuid())
  projectId     String
  blockKey      String // z.B. "Block-1" – eindeutig je Projekt
  name          String?
  pdfDocumentId String? // Referenz auf Document.id (Block-PDF)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([projectId, blockKey])
  @@index([projectId])
}

/// Eine Arbeitseinheit (Position) am Projekt.
model WorkItem {
  id        String  @id @default(cuid())
  projectId String
  blockId   String?

  /// Kennung zum Nehmen (Positions-/Raumnummer), eindeutig je Projekt
  itemKey String
  title   String?

  // Metadaten aus der Planung
  floor  String?
  area   String?
  room   String?
  type   String?
  rc     String?
  detail String?

  planPage   Int?
  sheetNo    Int?
  sheetTotal Int?

  pdfFile String?
  pdfPage Int?

  workScopeDe String? @db.Text
  workScopeSk String? @db.Text

  status WorkItemStatus @default(OPEN)

  importedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  block       ProjectBlock?        @relation(fields: [blockId], references: [id], onDelete: SetNull)
  materials   WorkItemMaterial[]
  assignments WorkItemAssignment[]
  sessions    WorkItemSession[]
  reports     WorkItemReport[]
  reviews     WorkItemReview[]

  @@unique([projectId, itemKey])
  @@index([projectId, status])
  @@index([blockId])
  @@index([itemKey])
}

/// Materialposition zu einem Work Item (aus Excel-Import).
model WorkItemMaterial {
  id         String   @id @default(cuid())
  workItemId String
  sortOrder  Int      @default(0)
  qty        String? // "1", "2", "n. Detail"
  qtyUnit    String? // "Stk.", "Satz"
  materialDe String
  materialSk String?
  createdAt  DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId])
}

/// Zuordnung eines CUSTOMER_PL-Users zu einem Projekt.
model ProjectCustomerPlAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, active])
}

/// Monteur-Zuordnung zu einem Work Item (aktiv von–bis).
model WorkItemAssignment {
  id         String    @id @default(cuid())
  workItemId String
  workerId   String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  active     Boolean   @default(true)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workItemId, active])
  @@index([workerId, active])
}

/// Zeitintervall "aktuelles Item" eines Monteurs (Item-Zeit).
/// Dauer = endedAt - startedAt, wenn endedAt gesetzt ist.
model WorkItemSession {
  id         String    @id @default(cuid())
  workItemId String
  workerId   String
  startedAt  DateTime
  endedAt    DateTime?

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workItemId, workerId])
  @@index([workerId, endedAt])
}

/// Rückmeldung des Monteurs: Fertigmeldung oder Nacharbeit.
/// Fotos hängen über DocumentLink (entityType = "WORK_ITEM_REPORT", entityId = report.id).
model WorkItemReport {
  id         String             @id @default(cuid())
  workItemId String
  workerId   String
  type       WorkItemReportType
  comment    String?            @db.Text
  reportedAt DateTime           @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workItemId, reportedAt])
  @@index([workerId])
}

/// Prüfung durch den Kunden-PL (geprüft / selbst fertiggesetzt).
model WorkItemReview {
  id             String               @id @default(cuid())
  workItemId     String
  reviewerUserId String
  action         WorkItemReviewAction
  comment        String?              @db.Text
  reviewedAt     DateTime             @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  reviewer User     @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@index([workItemId, reviewedAt])
  @@index([reviewerUserId])
}

/// Kartentyp-Template für PDF-OCR-Extraktion (SPEZ §10.2 Punkt 3-4).
/// Speichert Label-Hints und optionale Regex je Feld, damit der Extraktor
/// OCR-Text einer Arbeitskarte automatisch in itemKey/workScope/etc. parsen kann.
model WorkCardTemplate {
  id         String   @id @default(cuid())
  name       String
  customerId String?
  /// JSON: WorkCardFieldMapping[] – Felddefinitionen für die Extraktion
  fields     Json
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
}
